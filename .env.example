SECOND_BRAIN_ENV=development
SECOND_BRAIN_DATA_DIR=%LOCALAPPDATA%/SecondBrain/data
# SECOND_BRAIN_DATABASE_URL=sqlite+aiosqlite:///C:/chemin/second_brain.sqlite3
SECOND_BRAIN_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECOND_BRAIN_MAX_UPLOAD_MB=20

# Ollama reste local et n'est jamais appele directement par le frontend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=600
OLLAMA_READINESS_TIMEOUT_SECONDS=5
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_EXTRACTION_TEMPERATURE=0.0
OLLAMA_RAG_TEMPERATURE=0.1
OLLAMA_CLUSTER_LABEL_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE=5m
# Le client impose think=false pour les analyses, le RAG et le nommage des clusters.
OLLAMA_NUM_PREDICT_PASSAGE_ANALYSIS=512
OLLAMA_NUM_PREDICT_HIERARCHICAL_SUMMARY=512
OLLAMA_NUM_PREDICT_FINAL_SUMMARY=1024
OLLAMA_NUM_PREDICT_RAG=384
OLLAMA_NUM_PREDICT_CLUSTER_LABELS=384

# Budgets initiaux du pipeline IA, ajustables sans changer le code.
CHUNK_TARGET_TOKENS=800
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_SEGMENTS=2
CHUNK_SRT_PAUSE_MS=2500
EXTRACTION_MAX_RETRIES=1
EXTRACTION_MAX_KNOWLEDGE_PER_PASSAGE=2
JOB_STALE_HEARTBEAT_SECONDS=120

# Index vectoriel derive : le chemin reste relatif a SECOND_BRAIN_DATA_DIR.
QDRANT_PATH=qdrant
EMBEDDING_BATCH_SIZE=8
SEMANTIC_SEARCH_TOP_K=5

# RAG sourcé : récupération classée et contexte KnowledgeNode borné.
RAG_RETRIEVAL_TOP_K=8
RAG_CONTEXT_MAX_NODES=5
RAG_CONTEXT_MAX_CHARS=10000
RAG_KNOWLEDGE_MAX_CHARS=1200
RAG_MAX_EVIDENCE_PER_NODE=1
RAG_EVIDENCE_MAX_CHARS=400

# Phase 6A : graphe kNN, hiérarchie agglomérative et projection UMAP.
GRAPH_NEIGHBORS_K=8
GRAPH_MIN_SIMILARITY=0.45
GRAPH_TAG_WEIGHT=0.05
GRAPH_PCA_DIMENSIONS=50
CLUSTER_MIN_SIZE=5
CLUSTER_MAX_DOMAINS=6
CLUSTER_MAX_THEMES_PER_DOMAIN=6
CLUSTER_MIN_SILHOUETTE=0.1
CLUSTER_NOISE_IQR_FACTOR=1.5
CLUSTER_LABEL_BATCH_SIZE=12
CLUSTER_REPRESENTATIVE_COUNT=5
UMAP_NEIGHBORS=15
UMAP_MIN_DIST=0.15
UMAP_RANDOM_STATE=42
