SECOND_BRAIN_ENV=development
SECOND_BRAIN_DATA_DIR=%LOCALAPPDATA%/SecondBrain/data
# SECOND_BRAIN_DATABASE_URL=sqlite+aiosqlite:///C:/chemin/second_brain.sqlite3
SECOND_BRAIN_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECOND_BRAIN_MAX_UPLOAD_MB=20

# Ollama reste local et n'est jamais appele directement par le frontend.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen3.5:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=600
OLLAMA_READINESS_TIMEOUT_SECONDS=5
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2
OLLAMA_EXTRACTION_TEMPERATURE=0.0
OLLAMA_KEEP_ALIVE=5m
# Le client impose think=false pour tous les appels d'analyse.
OLLAMA_NUM_PREDICT_PASSAGE_ANALYSIS=512
OLLAMA_NUM_PREDICT_HIERARCHICAL_SUMMARY=512
OLLAMA_NUM_PREDICT_FINAL_SUMMARY=1024

# Budgets initiaux du pipeline IA, ajustables sans changer le code.
CHUNK_TARGET_TOKENS=800
CHUNK_MAX_TOKENS=1200
CHUNK_OVERLAP_SEGMENTS=2
CHUNK_SRT_PAUSE_MS=2500
EXTRACTION_MAX_RETRIES=1
EXTRACTION_MAX_KNOWLEDGE_PER_PASSAGE=2
JOB_STALE_HEARTBEAT_SECONDS=120
